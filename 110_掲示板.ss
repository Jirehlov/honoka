//-----------------------------------------------------------------
// 各キャラクターの掲示板出現判定
//-----------------------------------------------------------------
command $$check_character_bbs_disp(property $ch_no)
{
	// 同じキャラクターは一日に複数回選べないようにする
	if( @日付_時間帯 == @午後 )
	{
		if( @午前依頼を選択したキャラクター == $ch_no ) {
			return (0)
		}
	}
	
	// 各キャラクターの個別判定
	switch( $ch_no ) {
		
	case(@依頼者_スピカ)
		
		switch( @朱比華の依頼選択回数 ) {
			
		case(0)		// スピカ0001
			
			if( (12 <= @日付_日 && @日付_日 <= 14) && @日付_時間帯 == @午後 ) {
				return (1)
			}
			
		case(1)		// スピカ0002
			
			if( (15 <= @日付_日 && @日付_日 <= 16) && @日付_時間帯 == @午前 ) {
				return (1)
			}
			
		case(2)		// スピカ0003
			
			if( 16 <= @日付_日 && @日付_日 <= 17 ) {
				return (1)
			}
			
		case(3)		// スピカ0004
			
			if( 17 <= @日付_日 && @日付_日 <= 18 ) {
				return (1)
			}
			
		case(4)		// スピカ0005
			
			if( @日付_日 == 18 || (@日付_日 == 19 && @日付_時間帯 == @午後) ) {
				return (1)
			}
			
		case(5)		// スピカ0006
			
			if( (19 <= @日付_日 && @日付_日 <= 21) && @日付_時間帯 == @午後 ) {
				return (1)
			}
			
		case(6)		// スピカ0007
			
			if( (20 <= @日付_日 && @日付_日 <= 22) && @日付_時間帯 == @午後 ) {
				return (1)
			}
			
		case(7)		// スピカ0008
			
			if( (21 <= @日付_日 && @日付_日 <= 22) && @日付_時間帯 == @午後 ) {
				return (1)
			}
			
		case(8)		// スピカ0009
			
			if( 23 <= @日付_日 && @日付_日 <= 24 ) {
