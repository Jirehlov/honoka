//!    @note     マップ選択と同じ機能です。
//!              掲示板専用のマクロを使用することで表示するものやフローを設定することができます。
//!
//===========================================================================

#inc_start
	
	#macro	@掲示板条件チェック(@キャラクター)		$$check_character_bbs_disp(@キャラクター)
	
	#macro	@朱比華の依頼(@表示位置)
	
		if( @掲示板条件チェック(@依頼者_スピカ) )
		{
			switch( @朱比華の依頼選択回数 ) {
			case(0)		@依頼書表示("_bbs_request_btn0101", "_bbs_request0101", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0001", 10, "020_スピカ0001", 00)
			case(1)		@依頼書表示("_bbs_request_btn0102", "_bbs_request0102", @表示位置, @依頼者_スピカ, @依頼時間_一日, "020_スピカ0002", 10, "020_スピカ0002", 00)
			case(2)		@依頼書表示("_bbs_request_btn0103", "_bbs_request0103", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0003", 10, "020_スピカ0003", 00)
			case(3)		@依頼書表示("_bbs_request_btn0104", "_bbs_request0104", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0004", 10, "020_スピカ0004", 00)
			case(4)		@依頼書表示("_bbs_request_btn0105", "_bbs_request0105", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0005", 10, "020_スピカ0005", 00)
			case(5)		@依頼書表示("_bbs_request_btn0106", "_bbs_request0106", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0006", 10, "020_スピカ0006", 00)
			case(6)		@依頼書表示("_bbs_request_btn0107", "_bbs_request0107", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0007", 10, "020_スピカ0007", 00)
			case(7)		@依頼書表示("_bbs_request_btn0108", "_bbs_request0108", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0008", 10, "020_スピカ0008", 00)
			case(8)		
				if( @0708_無愛想な依頼書のほう ) {
						@依頼書表示("_bbs_request_btn0109", "_bbs_request0109", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0009", 10, "020_スピカ0009", 00)
				} else {
						@依頼書表示("_bbs_request_btn0110", "_bbs_request0110", @表示位置, @依頼者_スピカ, @依頼時間_半日, "020_スピカ0009", 10, "020_スピカ0009", 00)
				}
			}
		}
	
	#macro	@愛乃の依頼(@cell_no)
	
		l[0] = @掲示板条件チェック(@依頼者_愛乃)
		
		if( l[0] == 1 )
		{
			switch( @愛乃の依頼選択回数 ) {
			case(0)		@依頼書表示("_bbs_request_btn0201", "_bbs_request0201", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0001", 10, "030_愛乃0001", 00)
			case(1)		@依頼書表示("_bbs_request_btn0202", "_bbs_request0202", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0002", 10, "030_愛乃0002", 00)
			case(2)		@依頼書表示("_bbs_request_btn0203", "_bbs_request0203", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0003", 10, "030_愛乃0003", 00)
			case(3)		@依頼書表示("_bbs_request_btn0204", "_bbs_request0204", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0004", 10, "030_愛乃0004", 00)
			case(4)		@依頼書表示("_bbs_request_btn0205", "_bbs_request0205", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0005", 10, "030_愛乃0005", 00)
			case(5)		@依頼書表示("_bbs_request_btn0206", "_bbs_request0206", @cell_no, @依頼者_愛乃, @依頼時間_一日, "030_愛乃0006", 10, "030_愛乃0006", 00)
			}
		}
		elseif( l[0] == 2 )
		{
			@依頼書表示("_bbs_request_btn0207", "_bbs_request0207", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0007", 10, "030_愛乃0007", 00)
		}
		elseif( l[0] == 3 )
		{
			@依頼書表示("_bbs_request_btn0208", "_bbs_request0208", @cell_no, @依頼者_愛乃, @依頼時間_半日, "030_愛乃0008", 10, "030_愛乃0008", 00)
		}
		
