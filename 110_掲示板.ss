		switch( @掲示板条件チェック(@依頼者_町民６) ) {
		case(1)		@依頼書表示("_bbs_request_btn1207", "_bbs_request1207", @cell_no, @依頼者_町民６, @依頼時間_半日, "086_町民依頼0006", 10, "086_町民依頼0006", 00)
		}
		
	#macro	@町民７の依頼(@cell_no)
	
