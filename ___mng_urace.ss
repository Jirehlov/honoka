//---------------------------------------------------------------------------
// 定義
//---------------------------------------------------------------------------
#inc_start
	
	// オブジェクト番号
	#replace	<OBJ_HUNTER_RESULT_CARD>			10		// ハンター結果／カード
	#replace	<OBJ_HUNTER_RESULT_STATUS>			11		// ハンター結果／ステータス
	
	// オブジェクト定義
	#define		@obj_card			front.object[<OBJ_HUNTER_RESULT_CARD>]
	#define		@obj_status			front.object[<OBJ_HUNTER_RESULT_STATUS>]
	
	// ボタン番号
	#replace	@ボタン_次へ						21		// 次へ
	#replace	@ボタン_閉じる						101		// 閉じる
	
	// 変数
	#property	$i
	#property	$select_btn
	#property	$jump_file : str
	#property	$jump_label
	
	// deb
	#property	$deb_init
	
#inc_end


//===========================================================================
// ＵＭＡレースフロー(通常)
//===========================================================================
#z00

@シーン開始

@ＵＭＡレースユーザー制御開始

//--- ↓デバッグ用：初期設定
/*
if( @日付_日 == 12 && @日付_時間帯 == @午前 && $deb_init == 0 )
{
	@選択肢 = selbtn(
					"図鑑設定：図鑑フラグをリセットする",
					"図鑑設定：このまま始める（図鑑フラグを前回から引き継ぐ）"
	)@選択肢終了
	switch( @選択 ) {
	case(0)		$$init_uma_library_flag		$$init_item_library_flag
	case(1)
	}
	
	$$create_bbs_base_data
	$deb_init = 1
}
command $$init_all_item
{
	for( l[0] = 1, l[0] <= $$get_db_item_max, l[0] += 1 ) {
		if( $$get_db_item_default_num(l[0]) == 0 ) {
			$$add_urace_item(l[0], -<URACE_ITEM_MAX>)
		}
	}
}
*/
//--- ↑デバッグ用：初期設定

//--- 初回はチュートリアルへ
if( @日付_日 == 12 && @日付_時間帯 == @午前)
{
	gosub #z02
	
	return 
}

// グランドレース出場条件を満たしている場合
if( @日付_日 == <URACE_GRAND_ENTRY_DATE> && @日付_時間帯 == @午前 )
{
	if( $$get_urace_grand_entry_flag )
	{
		// グランドレース用フローへ
		goto #z01
	}
}

//---------------------------------------------------------------------------
// ＵＭＡ掲示板
farcall(___mng_urace_flow_bbs)

if( $$get_urace_played_race_in_bbs != 1 )
{
	// レースに参加していない
	@ＵＭＡレースユーザー制御解除
	return
}

//---------------------------------------------------------------------------
// レース前シナリオ
@fade(0)
@ＵＭＡレースユーザー制御解除

switch( @参加しているレース ) {
case(@レース_さすらいＣ)				$jump_file = "100_UMA0001"
case(@レース_銀河一記念)				$jump_file = "100_UMA0002"
case(@レース_魂争覇戦)					$jump_file = "100_UMA0003"
case(@レース_ＳＳ)						$jump_file = "100_UMA0004"
case(@レース_夢に向かって飛び立ちま賞)	$jump_file = "100_UMA0005"
case(@レース_真澄パラダイスＣ)			$jump_file = "100_UMA0006"
case(@レース_妹チャンピオンシップ)		$jump_file = "100_UMA0007"
case(@レース_記念杯大賞典ＳＣＦ)		$jump_file = "100_UMA0008"
case(@レース_凱風賞)					$jump_file = "100_UMA0009"
case(@レース_力こそ正義)				$jump_file = "100_UMA0010"
}
$jump_label = 0

farcall($jump_file,  $jump_label)

@fade(0)
@ＵＭＡレースユーザー制御開始

//---------------------------------------------------------------------------
// レース
farcall(___mng_urace_flow_paddock)		// パドック画面へ
farcall(___mng_urace_flow_race)			// レース画面へ
farcall(___mng_urace_flow_result)		// リザルト画面へ

//---------------------------------------------------------------------------
// レース後シナリオ
@fade(0)
@ＵＭＡレースユーザー制御解除

if( @レースの勝利者 == @オーナー_速川麦 )		{ $jump_label = 1 }		// プレイヤーが勝利
elseif( @レースの勝利者 == @レースのライバル )	{ $jump_label = 2 }		// ライバルが勝利
else											{ $jump_label = 3 }		// モブが勝利

farcall($jump_file, $jump_label)

@bs			// 立ち絵消去

@ＵＭＡレースユーザー制御開始

@fade(25)

@ＵＭＡレースユーザー制御解除

return (1)			// レースに参加した


//===========================================================================
// ＵＭＡレースフロー(グランドカップ)
//===========================================================================
#z01

@fade(0)

l[0] = @レース_ＵＭＡグランドカップ１回戦

//---------------------------------------------------------------------------
// レース設定
#z01_loop

// レースデータを初期化する
$$init_entry_race_data

// レースIDを設定する
$$set_entry_race_id(l[0])

// 参加者を設定する
$$set_urace_npc_race_entry_data

//---------------------------------------------------------------------------
// レース前シナリオ
@ＵＭＡレースユーザー制御解除

switch( @参加しているレース ) {
case(@レース_ＵＭＡグランドカップ１回戦)	$jump_file = "100_UMA0801"	$jump_label = 0
case(@レース_ＵＭＡグランドカップ２回戦)	$jump_file = "100_UMA0802"	$jump_label = 0
case(@レース_ＵＭＡグランドカップ準決勝)	$jump_file = "100_UMA0803"	$jump_label = 0
case(@レース_ＵＭＡグランドカップ決勝)		$jump_file = "100_UMA0804"	$jump_label = 0
case(@レース_ラストレース)					$jump_file = "100_UMA0804"	$jump_label = 240
}

farcall($jump_file, $jump_label)

@fade(0)
@ＵＭＡレースユーザー制御開始

//---------------------------------------------------------------------------
// レース
#z01_restart

farcall(___mng_urace_flow_paddock)		// パドック画面へ
farcall(___mng_urace_flow_race)			// レース画面へ
farcall(___mng_urace_flow_result)		// リザルト画面へ

//---------------------------------------------------------------------------
// レース後シナリオ
@ＵＭＡレースユーザー制御解除

if( @レースの勝利者 == @オーナー_速川麦 )		// プレイヤーが勝利
{
	switch( @参加しているレース ) {
	case(@レース_ＵＭＡグランドカップ１回戦)	$jump_label = 201
	case(@レース_ＵＭＡグランドカップ２回戦)	$jump_label = 211
	case(@レース_ＵＭＡグランドカップ準決勝)	$jump_label = 221
	case(@レース_ＵＭＡグランドカップ決勝)		$jump_label = 231
	case(@レース_ラストレース)					$jump_label = 241
												$jump_label = 250
	}
	
	farcall($jump_file, $jump_label)
	
	if( @参加しているレース == @レース_ラストレース )
	{
		@dm("エンディング")
		returnmenu
	}
}
else	// プレイヤー以外が勝利(グランドカップ以降はライバルとモブの区別はしない)
{
	if( @参加しているレース == @レース_ラストレース ) { $jump_label = 242 }
	else											  { $jump_label = 202 }
	
	farcall($jump_file, $jump_label)
	
	close
	
	if( @選択 == 0 ) {
		
		// レースデータを初期化する
		$$init_entry_race_data
		
		// レースIDを設定する
		$$set_entry_race_id(l[0])
		
		// 参加者を設定する
		$$set_urace_npc_race_entry_data
		
		goto #z01_restart	// やり直すを選択したのでレース前へ
	}
	else
	{
		returnmenu			// タイトルメニューへ
	}
}

@ＵＭＡレースユーザー制御開始

l[0] += 1

goto #z01_loop


//===========================================================================
// ＵＭＡレースフロー(チュートリアル)
//===========================================================================
#z02

@ＵＭＡレースユーザー制御解除

//-------------------------------------------------------
// ＵＭＡ参加選択シナリオ

l[0] = farcall("100_UMA0000", 10)

// ＵＭＡレースに参加しなかったので終了
if( l[0] == -1 )
{
	@fade(25)
	
	return
}

@ＵＭＡレースデータ初期化
@ＵＭＡレース_チュートリアル進行度 = 1

//-------------------------------------------------------
// 掲示板（レース選択）

// チュートリアルレースに設定する
$$set_entry_race_id(@レース_模擬レース)

// プレイヤーの手持ちをチュートリアルＵＭＡにする
$$create_wild_uma_data(@ＵＭＡ_ケセランパセラン, 0)	$$add_my_uma_from_wild_uma(0)
$$create_wild_uma_data(@ＵＭＡ_ツチノコ, 0)			$$add_my_uma_from_wild_uma(0)
$$create_wild_uma_data(@ＵＭＡ_スカイフィッシュ, 0)	$$add_my_uma_from_wild_uma(0)

// 掲示板へ
@ＵＭＡレースチュートリアル遷移("___mng_urace_flow_bbs")

@ＵＭＡレース_チュートリアル進行度 = 2

//-------------------------------------------------------
// パドック

// 参加者を設定する
$$set_urace_npc_race_entry_data

// パドックへ
@ＵＭＡレースチュートリアル遷移("___mng_urace_flow_paddock")

@ＵＭＡレース_チュートリアル進行度 = 3

//-------------------------------------------------------
// チュートリアルレースへ

// レースへ
@ＵＭＡレースチュートリアル遷移("___mng_urace_flow_race")
@ＵＭＡレースチュートリアル遷移("___mng_urace_flow_result")

@fade(25)

@ＵＭＡレース_チュートリアル進行度 = 4

//-------------------------------------------------------
// レース終了後シナリオへ
@ＵＭＡレースチュートリアルシナリオ(14)

@fade(25)

@ＵＭＡレース_チュートリアル進行度 = 5

//-------------------------------------------------------
// ハンター依頼へ

// プレイヤーの手持ちをリセットする
for( l[0] = 0, l[0] < $$get_my_uma_num, l[0] += 1 )
{
	$$del_my_uma(0)
}

// チュートリアル用ハンターリストを作成する
$$create_bbs_tutorial_hunter_list

@ＵＭＡレースチュートリアル遷移("___mng_urace_flow_bbs")

@fade(25)

@ＵＭＡレースチュートリアルシナリオ(16)

@ＵＭＡレース_チュートリアル進行度 = 6

//-------------------------------------------------------
// 厩舎へ

@fade(25)

// 厩舎へ
@ＵＭＡレースチュートリアル遷移("___mng_urace_flow_barn")

@fade(25)

//-------------------------------------------------------
// チュートリアル終了

@ＵＭＡレースチュートリアルシナリオ(18)

$$urace_font_disable
@ＵＭＡレースユーザー制御解除

return

//===========================================================================
// ＵＭＡハンター依頼の結果
//===========================================================================
#z10

@昼

for( $i = 0, $i < <BBS_HUNTER_MAX>, $i += 1 )
{
	// ＵＭＡハンターの依頼を実行する
	$$execute_hunter_request($i)
	
	// 依頼がある場合はシナリオへ
	if( @会話中のＵＭＡハンター != 0 ) {
;		@ＵＭＡハンター結果シナリオへ
	}
}

return


//===========================================================================
// 捕まえたＵＭＡの表示
//===========================================================================
#z11

@ＵＭＡレースユーザー制御開始

// ＵＭＡカードを作成する
$$create_uma_card_object(@obj_card, $$get_uma_id(<URACE_WILD_OWNER_ID>, 0), 0, 0)
$$show_catch_uma_card_animation(@obj_card)			// カードアニメーションを表示する

// アニメーション待ち
timewait_key(1000)
@obj_card.all_eve.end

// ＵＭＡステータスを作成する
$$create_uma_status_object(@obj_status, <URACE_WILD_OWNER_ID>, 0, 920, 134)
$$show_catch_uma_status_animation(@obj_card, @obj_status)		// ステータスアニメーションを表示する

// 次へボタンを作成する
$$create_ui_button(front.object[@ボタン_次へ], _mng_ur_common_next_btn, 1578, 918, @ボタン_次へ, <URACE_BTN_GROUP_NORMAL>, 1)

// 入力制御を開始する
$$input_start(front, <URACE_BTN_GROUP_NORMAL>)

while(1)
{
	// 入力制御を更新する
	$select_btn = $$input_update(front, <URACE_BTN_GROUP_NORMAL>)
	
	// キャンセルは次へボタンとして処理する
	if( $select_btn == -1 )
	{
		$select_btn = @ボタン_次へ
	}
	
	// 次へボタンが押された場合は終了する
	if( $select_btn == @ボタン_次へ )
	{
		break
	}
	
	input.next		// 入力の更新
	disp			// 画面の更新
}

@obj_card.init
@obj_status.init
front.object[@ボタン_次へ].init

@ＵＭＡレースユーザー制御解除

return


