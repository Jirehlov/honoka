;＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;(市川)：演出チェック用のジャンプラベル
;	goto #script
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝

;>>選択肢	一度選んだ選択肢は消える

@選択肢 = selbtn(
	スピカと遊ぶ,
	愛乃と遊ぶ,
	淡雪と遊ぶ,
	六花と遊ぶ,
	河瀬と遊ぶ,
	玖琉未と遊ぶ,
	塁と遊ぶ,
	つづらと遊ぶ
)@選択肢終了

if (@選択 == 0)	{	;>>スピカと遊ぶ
	farcall("050_小詠Play01")	goto #Play_END
}elseif(@選択 == 1){	;>>愛乃と遊ぶ,
	farcall("050_小詠Play02")	goto #Play_END
}elseif(@選択 == 2){	;>>淡雪と遊ぶ,
	farcall("050_小詠Play03")	goto #Play_END
}elseif(@選択 == 3){	;>>六花と遊ぶ,
	farcall("050_小詠Play04")	goto #Play_END
}elseif(@選択 == 4){	;>>河瀬と遊ぶ,
	farcall("050_小詠Play05")	goto #Play_END
}elseif(@選択 == 5){	;>>玖琉未と遊ぶ
	farcall("050_小詠Play06")	goto #Play_END
}elseif(@選択 == 6){	;>>塁と遊ぶ,
	farcall("050_小詠Play07")	goto #Play_END
}elseif(@選択 == 7){	;>>つづらと遊ぶ
	farcall("050_小詠Play08")	goto #Play_END
}

;>>遊び終わり

