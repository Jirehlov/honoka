#inc_start
	
	// データベース番号
	#replace	<DB_UMA>			0		// ＵＭＡ
	#replace	<DB_NPC_UMA>		1		// ＮＰＣのＵＭＡ
	#replace	<DB_SKILL>			2		// スキル
	#replace	<DB_RACE>			3		// レース(大会)
	#replace	<DB_TRAP>			4		// レース障害物
	#replace	<DB_ITEM>			5		// アイテム(報酬)
	#replace	<DB_HUNTER>			6		// ＵＭＡハンター
	#replace	<DB_OWNER>			7		// オーナー(ＵＭＡレース参加者)
	
	// データベース定義
	#define		@db_uma				database[<DB_UMA>]			// ＵＭＡ
	#define		@db_npc_uma			database[<DB_NPC_UMA>]		// ＮＰＣのＵＭＡ
	#define		@db_skill			database[<DB_SKILL>]		// スキル
	#define		@db_race			database[<DB_RACE>]			// レース(大会)
	#define		@db_trap			database[<DB_TRAP>]			// レース障害物
	#define		@db_item			database[<DB_ITEM>]			// アイテム(報酬)
	#define		@db_hunter			database[<DB_HUNTER>]		// ＵＭＡハンター
	#define		@db_owner			database[<DB_OWNER>]		// オーナー(ＵＭＡレース参加者)
	
#inc_end

#z00

//===============================================================================================
// データベース(ＵＭＡ)
//===============================================================================================
//---------------------------------------------------------------------------
// 指定したＩＤのＵＭＡの名前を取得する
//---------------------------------------------------------------------------
command $$get_db_uma_name(property $id) : str
{
	return (@db_uma.get_str($id, 0))
}

//---------------------------------------------------------------------------
// 指定したＩＤのＵＭＡのレアリティを取得する
//---------------------------------------------------------------------------
command $$get_db_uma_rarity(property $id) : int
{
	return (@db_uma.get_num($id, 1))
}

//---------------------------------------------------------------------------
// 指定したＩＤのＵＭＡの走行タイプを取得する
//---------------------------------------------------------------------------
command $$get_db_uma_run_type(property $id) : int
{
	return (@db_uma.get_num($id, 2))
}

//---------------------------------------------------------------------------
// 指定したＩＤのＵＭＡのライフを取得する
//---------------------------------------------------------------------------
command $$get_db_uma_life(property $id) : int
{
	return (@db_uma.get_num($id, 3))
}

//---------------------------------------------------------------------------
// 指定したＩＤのＵＭＡのスピードを取得する
//---------------------------------------------------------------------------
command $$get_db_uma_speed(property $id) : int
{
	return (@db_uma.get_num($id, 4))
}

