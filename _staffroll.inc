//---------------------------------------------------------------------------
// 汎用
//---------------------------------------------------------------------------
#macro	@汎用ＥＤ(@auto_fade(1))
	if( @auto_fade ) {
		@se_stop_all(5000)
		@bgm_stop(5000)
		@fade_w_all(7)
		@all_sound_stop(1000)
		@waitkey(1000)
		@all_sound_stop(0)
	}
	$$common_ed(1)

#command $$common_ed(int)


