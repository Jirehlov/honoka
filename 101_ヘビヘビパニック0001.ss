#z00

;>>ヘビヘビ初回
if( @ヘビパ_プレイ回数 == 0 )
{
	//＜背景：掲示板＞

	【依頼書】『ヘビを叩くだけの簡単なお仕事。真澄町のスゴウデ、厩舎に集え！』R

	【麦】「ヘビをたたく……？」R

	【麦】「ヘビ退治が依頼内容なのだろうか」R

	【麦】「依頼者は……広美さん」R

	【麦】「案外、ヘビが苦手だったりするんだろうか」R
}


;>>ボス：ヤマタノオロチ
elseif( @ヘビパ_ヤマタノオロチ発生中 )
{
	【依頼書】『ヘビを叩くだけの簡単なお仕事。真澄町のスゴウデ、厩舎に集え！』R

	【麦】「ん……？　紙裏に何か書いてある」R

	【麦】「『首が分かれてた大物が出てきそう』」R

	;>>ヤマタノオロチ_初戦
	if( @ヘビパ_ヤマタノオロチリベンジ中 == 0 ) {
		【麦】「それはもうヘビを超えて、化け物では？」R
	}
	
	;>>ヤマタノオロチ_リベンジ
	else {
		
		【麦】「アイツがまた……」R
	
		【麦】「今度こそ勝つ」R
	}
}

;>>ボス：ヒュドラ
elseif( @ヘビパ_ヒュドラ発生中 )
{
	【依頼書】『ヘビを叩くだけの簡単なお仕事。真澄町のスゴウデ、厩舎に集え！』R

	【麦】「あっ……また紙裏にメモが」R

	【麦】「『すぐに再生する大物が出てきそう』」R

	;>>ヒュドラ_初戦
	if( @ヘビパ_ヒュドラリベンジ中 == 0 ) {
	
		【麦】「さ、再生！？　もはや怪物だ……」R
	}

	;>>ヒュドラ_リベンジ
	else {

		【麦】「アイツがまた……」R
	
		【麦】「今度こそ勝つ」R
	}
}

;>>ボス：メデューサ
elseif( @ヘビパ_メデューサ発生中 )
{
	【依頼書】『ヘビを叩くだけの簡単なお仕事。真澄町のスゴウデ、厩舎に集え！』R

	【麦】「紙裏になんか書いてある……読むのが怖い……」R

	【麦】「『大物注意』」R

	;>>メデューサ_初戦
	if( @ヘビパ_メデューサリベンジ中 == 0 ) {
	
		【麦】「あと何回大物と戦えばいいんだ……」R
	}
	
	;>>メデューサ_リベンジ
	else {
		
		【麦】「アイツは確かに強い」R
	
		【麦】「でも、今度こそは……！」R
	}
}


//２回目以降
else
{
	【依頼書】『ヘビを叩くだけの簡単なお仕事。真澄町のスゴウデ、厩舎に集え！』R

	【麦】「またヘビ退治か」R

	【麦】「真澄町のどこにそんなたくさんのヘビが……」R
}

return


