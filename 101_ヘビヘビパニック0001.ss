	}
	
	;>>お助けキャラが愛乃の場合
	elseif( @ヘビパ_サポートキャラ_愛乃 ) {
		
		@bs(ai11_01)
		KOE(614200419,002)【愛乃】「いやー、火とか吐かれなくてよかったですね」R
		【麦】「それはもう怪獣だ」R
	}
	
	;>>お助けキャラが淡雪の場合
	elseif( @ヘビパ_サポートキャラ_淡雪 ) {
		
		@bs(hi11_01)
		KOE(614200423,003)【陽彩】「まずまずの体験だったわね。もうちょっと骨のある戦いでもいいのに」R
		【麦】「これ以上のはやめて欲しい……」R
	}
	
	;>>お助けキャラが小詠の場合
	elseif( @ヘビパ_サポートキャラ_小詠 ) {
		
		@bs(ky11_01)
		KOE(614200427,004)【小詠】「ヘビって、頭があんなにいっぱいあるものなんですか？」R
		【麦】「いや、俺もあんなヘビ知らない」R
	}
	
	;>>お助けキャラが六花の場合
	elseif( @ヘビパ_サポートキャラ_六花 ) {
		
		@bs(rk11_01)
		KOE(614200431,005)【六花】「見たことないヘビにも物怖じしない兄さん、ご立派です」R
		【麦】「わりと虚勢を張ってた節はあるよ」R
		
		@bf(rk11_01)
		KOE(614200433,005)【六花】「そんな姿を微塵も感じさせない兄さん、ご立派です！」R
	}
	
	;>>合流
	@bs
	
	【麦】「なんか思ってたヘビ退治と違うな」R

	@bs(hr11_01)
	KOE(614200439,006)【広美】「真澄町だからな。ヤマタノオロチくらいでてくるだろう」R

	【麦】「真澄町、やばいですね……」R

	@bs
	
	KOE(614200443,050)【ヤマタノオロチ】「しゃー」R

	@face(hr11_01)
	KOE(614200445,006)【広美】「な、なんだって？！」R

	【麦】「ん？」R

	@bs(hr11_01)
	KOE(614200449,006)【広美】「〝俺はボスの中でも最弱。俺を倒したくらいで調子に乗るな”と言っているぞ」R

	【麦】「鳴き声と文字数が合ってない」R

	【麦】「というかヘビの言葉がわかるんですか？」R

