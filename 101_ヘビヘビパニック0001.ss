#z02

@シーン開始

//＜背景：牧場＞
@bg(bg021, 25)

//ヘビヘビ初回
if( @ヘビパ_プレイ回数 == 1 ){

	@bgm(bgm21)
	
	;>>ヘビヘビパニック勝利
	if( @ヘビパ_勝利 ) {
		
		@bs(hr11_01, sp11_01)
		KOE(614200344,006)【広美】「さすが、私が見込んだだけのことはある」R

		@bf(sp11_01)
		KOE(614200346,001)【スピカ】「私たちの卵は守られたわね」R

		@bf(hr11_01)
		KOE(614200348,006)【広美】「次回もよろしく頼むぞ」R

		【麦】「次回？　そんな定期的に来るんですか」R
	}

	;>>ヘビヘビパニック敗北
	else {

		@bs(hr11_01, sp11_01)
		KOE(614200354,006)【広美】「おいおい」R

		@bf(sp11_01)
		KOE(614200356,001)【スピカ】「何やってるのよ、麦！」R

		【麦】「ごめん……」R

		なんで無尽蔵にヘビが湧いてくるんだ。R

		【麦】「あいつら、押し寄せ過ぎですよ」R
	}
	
	;>>合流
	@bf(hr11_01)
	KOE(614200365,006)【広美】「それぐらい、うちの卵は魔性なんだ」R

	【麦】「そ、そんなに……」R

	@bs
	
	生唾を飲む。食べてみたい。R

	@bs(ai11_01)
	KOE(614200371,002)【愛乃】「スチャ」R	;>>飛んできて着地

	@bf(ai11_01)
	KOE(614200373,002)【愛乃】「お話は聞かせてもらいましたよ」R

	【麦】「愛乃？」R

	@bs(hi11_01)
	KOE(614200377,003)【陽彩】「珍しそうな卵ね。淡雪も食べてみたいわ」R

	@bs(hi, rk11_01)
	KOE(614200379,005)【六花】「兄さんが求める物はわたしが求める物。是非頂きましょう」R

	【麦】「淡雪に六花まで」R

	@bs(ky11_01)
	KOE(614200383,004)【小詠】「ぴぃ……ヘビ、コワい……」R

	【麦】「小詠もいたのか」R

	@bf(ky11_01)
	KOE(614200387,004)【小詠】「ヘビは退治しなければなりません」R

	@bf(ky11_01)
	KOE(614200389,004)【小詠】「私の……いえ、真澄町の安寧のためにもっ」R

	【麦】「自分が苦手なだけだろう」R

	@bs(hr11_01, sp11_01)
	KOE(614200393,001)【スピカ】「いきなり大所帯になったわね」R

	@bf(hr11_01)
	KOE(614200395,006)【広美】「なら、次はみんなにも手伝ってもらうとしようかね」R

	【麦】「まあ、人は多ければ多いほどいいですしね」R

	@bs
	
	でも。R

	いつまで退治し続けないといけないんだろうか……R

	@ヘビパ_サポート解禁ウィンドウ
	
}

;>>ボス：オロチ討伐
elseif( @ヘビパ_ヤマタノオロチ討伐 )
{
	@bgm(bgm21)
	
	KOE(614200408,050)【ヤマタノオロチ】「シャウウ……」R

	//ＳＥ：パタリ

	【麦】「昔話に出てきそうなフォルムだった……」R

	;>>お助けキャラがスピカの場合
	if( @ヘビパ_サポートキャラ_スピカ ) {
		
		@bs(sp11_01)
		KOE(614200415,001)【スピカ】「そうかしら？　そんなに珍しくないと思ったけど」R
