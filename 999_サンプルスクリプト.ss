#inc_start

	#macro		@サンプルシーン開始(@bg_file(bg001_01))
		@シーン開始
		@bg(@bg_file, 0)
	
	#macro		@サンプルシーン終了
		@fade(2)
		@bg(bg002_01, 0)

#inc_end

//-----------------------------------------------------------------
// サンプルスクリプト選択
//-----------------------------------------------------------------
#z00

@bg(bg002_01, 0)

l[0] = selbtn(背景, 立ち絵, 台詞中の立ち絵変更／顔グラ, イベントＣＧ／カットイン, エフェクト, 環境エフェクト, 演出, サウンド, タイトルへ)
switch( l[0] ) {
case(0)		goto #z00_01
case(1)		goto #z00_02
case(2)		goto #z00_03
case(3)		goto #z00_04
case(4)		goto #z00_05
case(5)		goto #z00_08
case(6)		goto #z00_09
case(7)		goto #z00_10
case(8)		returnmenu
}

// 背景
#z00_01

l[0] = selbtn(フェード, 背景の表示, 背景の移動／パン／ターン, 背景の拡縮, 時間帯の管理, 戻る)
switch( l[0] ) {
case(0)		goto #z10
case(1)		goto #z11
case(2)		goto #z12
case(3)		goto #z13
case(4)		goto #z14
default		goto #z00
}

// 立ち絵
#z00_02

l[0] = selbtn(基本（表示／非表示）, 表情指定, 表示モードの変更, 座標移動, 重なり順の変更, 透明度の変更, スライドイン／スライドアウト, アクション, 戻る)
switch( l[0] ) {
case(0)		goto #z20
case(1)		goto #z21
case(2)		goto #z22
case(3)		goto #z23
case(4)		goto #z24
case(5)		goto #z25
case(6)		goto #z26
case(7)		goto #z27
default		goto #z00
}

// 顔グラ
#z00_03

l[0] = selbtn(台詞中の立ち絵変更, 顔グラ基本（表示／非表示）, 戻る)

switch( l[0] ) {
case(0)		goto #z30
case(1)		goto #z31
default		goto #z00
}

// イベントＣＧ
#z00_04

l[0] = selbtn(イベントＣＧの表示, イベントＣＧの移動／パン, イベントＣＧの拡縮, 一枚絵のカットイン, 戻る)
switch( l[0] ) {
case(0)		goto #z40
case(1)		goto #z41
case(2)		goto #z42
case(3)		goto #z45
default		goto #z00
}

// エフェクト１
#z00_05

l[0] = selbtn(次のエフェクトへ, フラッシュ, 色調変化, 画面揺れ, フィルター, シネマスコープ, ノイズエフェクト, 回想枠, 集中線, 目眩, 戻る)
switch( l[0] ) {
case(0)		goto #z00_06
case(1)		goto #z50
case(2)		goto #z51
case(3)		goto #z52
case(4)		goto #z53
case(5)		goto #z54
case(6)		goto #z55
case(7)		goto #z56
case(8)		goto #z57
case(9)		goto #z58
default		goto #z00
}

// エフェクト２
#z00_06

l[0] = selbtn(前のエフェクトへ, 湯気, 煙, 霧, レンズフレア, 戻る)
switch( l[0] ) {
case(0)		goto #z00_05
case(1)		goto #z60
case(2)		goto #z61
case(3)		goto #z62
case(4)		goto #z63
default		goto #z00
}

// 環境エフェクト
#z00_08

l[0] = selbtn(雪, 雨, 塵, 火の粉, 光の玉, 桜, 戻る)
switch( l[0] ) {
case(0)		goto #z80
case(1)		goto #z81
case(2)		goto #z82
case(3)		goto #z83
case(4)		goto #z84
case(5)		goto #z85
default		goto #z00
}

// 演出
#z00_09

l[0] = selbtn(時間待ち, ブライトイン／アウト, 画像文字, メッセージの文字サイズ変更, テキストセンタリング, 戻る)
switch( l[0] ) {
case(0)		goto #z90
case(1)		goto #z91
case(2)		goto #z92
case(3)		goto #z93
case(4)		goto #z94
default		goto #z00
}

// サウンド
#z00_10

l[0] = selbtn(ＢＧＭ, ＳＥ, すべてのサウンド, 戻る)
switch( l[0] ) {
case(0)		goto #z100
case(1)		goto #z101
case(2)		goto #z102
default		goto #z00
}


//-----------------------------------------------------------------
// 背景：フェード
//-----------------------------------------------------------------
#z10

@サンプルシーン開始

@bs(sp11_01)

フェードサンプル。R

@フェード

"["＠フェード"]"命令でフェードを実行しました。NLI
背景、立ち絵などすべてのオブジェクトが非表示になります。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

"["＠フェード"]"命令にはワイプ番号を指定できます。R

@フェード(54)

ワイプ番号５４でフェードを実行しました。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

２番目の設定でフェードにかける時間を指定できます。R

@フェード(54, 2000)

ワイプ番号５４で２秒かけてフェードを実行しました。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

"["＠白フェード"]"命令で白フェードを実行することができます。R

@白フェード

白フェードを実行しました。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

"["＠フェード全体"]"命令でメッセージウィンドウごとフェードをかけることができます。R

@フェード全体

メッセージウィンドウごとフェードを実行しました。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

"["＠白フェード全体"]"命令でメッセージウィンドウごと白フェードをかけることができます。R

@白フェード全体

メッセージウィンドウごと白フェードを実行しました。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

"["＠カラーフェード"]"命令でフェード色を指定してフェードをすることができます。R

@カラーフェード(128, 0, 0)

暗い赤フェードをしました。NLI
Ｒ＝赤、Ｇ＝緑、Ｂ＝青の順番で色を指定できます。NLI
各色は０～２５５の範囲での指定になります。R

@bs_set(sp11_01)
@bg(bg001_01, 0)

"["＠カラーフェード全体"]"命令でメッセージウィンドウごと色指定フェードをかけることができます。R

@カラーフェード全体(0, 128, 0, 54, 2000)

ワイプ番号５４で２秒かけて暗い緑フェードを実行しました。NLI
フェードサンプルを終了します。R

@サンプルシーン終了

goto #z00_01


//-----------------------------------------------------------------
// 背景：基本（表示）
//-----------------------------------------------------------------
#z11

@サンプルシーン開始

背景表示サンプル。R

@bg(bg002_01)

"["＠ｂｇ"]"命令で背景を表示しました。R

@bs(sp11_01, rk11_01)

背景を変更すると、表示されているすべての立ち絵は非表示になります。R

@bg(bg001_01)

背景を変更しました。NLI
立ち絵はすべて非表示になりました。R

"["＠ｂｇ"]"命令にはワイプ番号を指定できます。R

@bg(bg002_01, 54)

ワイプ番号５４でワイプを実行しました。NLI
また、３番目の設定でフェードにかける時間を指定できます。R

@bg(bg001_01, 54, 2000)

ワイプ番号５４で２秒かけてワイプを実行しました。R

４番目の設定でメッセージウィンドウを閉じるかどうか、NLI
５番目の設定でワイプの終了を待つかどうかを指定できます。R

@bg(bg002_01, 3, 500, 0, 0)

メッセージウィンドウを閉じない、ワイプ終了を待たない背景の表示をしました。R

ワイプ番号に－１を設定することでワイプを行わず、NLI
背景を裏画面に設定することができます。R

@bg(bg001_01, -1)

背景を裏画面に設定しました。R

@wipe(3)

"["＠ｗｉｐｅ"]"命令で背景を表示しました。R

@bg_set(bg002_01)

"["＠ｂｇ＿ｓｅｔ"]"命令でも裏画面に背景を設定できます。R

@wipe(3)

"["＠ｗｉｐｅ"]"命令で背景を表示しました。R

"["＠ｂｇ＿ｓｅｔ"]"命令では背景の拡縮率、ｘｙ座標の補正も設定できます。R

@bg_set(bg001_01, 2000, -300, -300)
@wipe(3)

背景を２倍の大きさでｘ座標を－３００、ｙ座標を－３００して表示しました。R

背景表示サンプルを終了します。R

@サンプルシーン終了

goto #z00_01


//-----------------------------------------------------------------
// 背景：移動／パン／ターン
//-----------------------------------------------------------------
#z12

@サンプルシーン開始

背景の移動／パン／ターンサンプル。NLI
"["＠ｂｇ＿ｍｏｖｅ"]"命令で背景を移動することができます。R

@bg_move(bg002_01, 3, -480, 200, 480, 200, 30000)

１．５倍に拡大した背景を３０秒かけて、NLI
Ｘ座標＝－４８０→４８０、Ｙ座標＝２００で移動しています。NLI
ワイプ番号は３です。R

"["＠ｂｇ＿ｐａｎ"]"命令では座標ではなく分割したブロック間の移動ができます。
ブロックについては"["スクリプトマニュアル→背景の移動／パン"]"に記述してあります。R

@bg_pan(bg001_01, 3, 1, 9, 30000)

ブロック１（左上）からブロック９（右下）にNLI
１．５倍拡大した背景を３０秒かけてワイプ番号３で移動しています。R

ブロック指定にすると細かい座標の入力が必要なく、簡易な番号で指定できます。R

@bg_pan_lr(bg001_01)

また、背景パンにはそれぞれ簡易な命令があります。NLI
"["＠ｂｇ＿ｐａｎ＿ｌｒ"]"命令は左から右に背景パンを行います。R

@bg_pan_rl(bg001_01)

"["＠ｂｇ＿ｐａｎ＿ｒｌ"]"命令は右から左に背景パンを行います。R

@bg_pan_ud(bg001_01)

"["＠ｂｇ＿ｐａｎ＿ｕｄ"]"命令は上から下に背景パンを行います。R

@bg_pan_du(bg001_01)

"["＠ｂｇ＿ｐａｎ＿ｄｕ"]"命令は下から上に背景パンを行います。R

@bg(bg001_01)

また、"["＠ｂｇ＿ｔｕｒｎ"]"命令で背景を左右にループ移動することができます。R

@bg_turn(bg001_01, 3, 4, 6, 3000)

ブロック４（左中）からブロック６（右中）にNLI
１．５倍拡大した背景を３秒かけてループ移動しています。R

背景の移動／パン／ターンサンプルを終了します。R

@サンプルシーン終了

goto #z00_01


//-----------------------------------------------------------------
// 背景：拡縮
//-----------------------------------------------------------------
#z13

@サンプルシーン開始

背景の拡縮サンプル。NLI
"["＠ｂｇ＿ｚｏｏｍ"]"命令で背景を拡縮することができます。R

@bg_zoom(bg001_01, 3, 1500, 2000, 30000)

画像の中心を基準に１．５倍から２倍に３０秒かけて拡大しています。NLI
ワイプ番号は３です。R

@bg_zoom(bg001_01, 3, 1500, 2000, 30000, 0, 1, 1, 0, 0)

拡縮の中心点を変更する場合は、９番目と１０番目の設定で座標を指定することで実行できます。NLI
中心点をｘ座標＝０、ｙ座標＝０に設定しています。R

@bg_zoom_up(bg002_01)

背景の拡縮にはそれぞれ簡易な命令があります。NLI
"["＠ｂｇ＿ｚｏｏｍ＿ｕｐ"]"命令は１倍から１．５倍にズームアップを行います。R

@bg_zoom_down(bg001_01)

"["＠ｂｇ＿ｚｏｏｍ＿ｄｏｗｎ"]"命令は１．５倍から１倍にズームダウンを行います。R

背景の拡縮サンプルを終了します。R

@サンプルシーン終了

goto #z00_01


//-----------------------------------------------------------------
// 背景：時間帯の管理
//-----------------------------------------------------------------
#z14

@サンプルシーン開始(bg008)

@bs(sp11_01)

時間帯管理の機能を有効にしている場合は、NLI
"["＠昼"]" "["＠夕"]" "["＠夜"]" "["＠朝"]"命令を使用することができます。R

@夕
@bg(bg008)

"["＠夕"]"命令で夕方の背景にしました。NLI
夕方の背景に変更されない場合は、"app_settings.inc"の"__USE_TIME_CONTROL"が０になっていないか確認してください。R

時間帯管理の機能を有効にしていると、"bg008"の指定で"bg008_02"が表示されるようになります。R

@bg(bg008_01)

直接指定するファイル名が存在する場合は、そちらを優先して表示します。NLI
"bg008_01"を指定して、夕方の時間ですが昼の背景を表示しました。R

@夜

@bg(bg008)

夜の時間帯にして、"bg008"指定で"bg008_03"の背景を表示しました。NLI
時間帯管理サンプルを終了します。R

@サンプルシーン終了

goto #z00_01


//-----------------------------------------------------------------
// 立ち絵：基本（表示／非表示）
//-----------------------------------------------------------------
#z20

@サンプルシーン開始

立ち絵基本命令サンプル。R

@bs(rk11_01)

"["＠ｂｓ"]"命令で立ち絵を表示しました。NLI
次に立ち絵を２人表示します。R

@bs(rk11_01, sp11_01)

"["＠ｂｓ"]"命令で立ち絵を２人表示しました。NLI
"["＠ｂｓ"]"命令では最大５人まで立ち絵を指定できます。R

@bs(rk11_01, sp11_01, fm11_01)

R

@bs(rk11_01, sp11_01, fm11_01, hr11_01)

R

@bs(rk11_01, sp11_01, fm11_01, hr11_01, ri11_01)

"["＠ｂｓ"]"命令では自動的に位置が補正されるようになっています。NLI
それぞれの位置は "[app_settings.ss] → [" 立ち絵のデフォルトｘ座標の設定 "]" で設定できます。R

また、"["＠ｂｓ"]"命令で立ち絵を指定しない場合は全ての立ち絵が非表示になります。R

@bs

全ての立ち絵を非表示にしました。R

@bs(rk11_01, sp11_01)

また、立ち絵指定の代わりに"["＜ｎｂ＞"]"指定を使うことで、NLI
３人の立ち位置で左と右にだけキャラクターを表示するといったこともできるようになります。R

@bs(rk11_01, <nb>, sp11_01)

３人の立ち位置で左と右にだけキャラクターを表示しました。R

@bs(<nb>, <nb>, rk11_01, <nb>, sp11_01)

５人の立ち位置で真ん中と右外側にだけキャラクターを表示しました。R

@bs(rk11_01, sp11_01)

指定したキャラクターを非表示にする方法は２種類あります。R

@bs(rk11_01)

一つは"["＠ｂｓ"]"命令で指定から外す方法です。NLI
こちらは位置が自動で補正されます。R

@bs(rk11_01, sp11_01)

もう一つは"["＠ｂｓ＿ｄｅｌ"]"命令を使用する方法です。NLI
こちらは位置の補正が行われません。R

@bs_del(sp)

"["＠ｂｓ＿ｄｅｌ"]"命令で指定した立ち絵を非表示にしました。R

@bs

"["＠ｂｓ＿ｗ"]"命令で指定した立ち絵の表示に追加してワイプ番号を指定できます。R

@bs_w(3, sp11_01)

立ち絵の表示をワイプ番号３で実行しました。R

@bs_w(54)

立ち絵の非表示をワイプ番号５４で実行しました。R

@bs(rk11_01, sp11_01)

同様に"["＠ｂｓ＿ｄｅｌ＿ｗ"]"命令でも立ち絵の非表示にワイプ番号を指定できます。R

@bs_del_w(54, sp)

立ち絵の非表示をワイプ番号５４で実行しました。R

@bs(rk11_01, sp11_01)

"["＠ｂｆ"]"命令では立ち位置は変更せず、指定したキャラクターの表情だけを切り替えます。R

@bf(rk11_04)

"["＠ｂｆ"]"命令で指定したキャラクターの表情だけを切り替えました。NLI
複数のキャラクターの表情切り替えも行えます。R

@bf(rk11_16, sp11_04)

"["＠ｂｆ"]"命令で複数のキャラクターの表情を切り替えました。NLI
"["＠ｂｓ"]"命令と同じで最大５人までの表情を指定できます。R

"["＠ｂｆ＿ｗ"]"命令で指定した立ち絵の表情変更に追加してワイプ番号を指定できます。R

@bf_w(3, rk11_01, sp11_01)

立ち絵の表情変更をワイプ番号３で実行しました。R

@bs

"["＠ｂｓ＿ｓｅｔ"]"命令では立ち絵を裏画面に待機させることができます。R

@bs_set(rk11_01)

"["＠ｂｓ＿ｓｅｔ"]"命令で指定のキャラクターを裏画面に待機させました。NLI
次の"["＠ｗｉｐｅ"]"命令で表画面に表示されるようになります。R

@wipe(0)

"["＠ｗｉｐｅ"]"命令でキャラクターを表示しました。R

@bs_set(rk11_01, -400)
@wipe(0)

"["＠ｂｓ＿ｓｅｔ"]"命令ではキャラクターの位置を設定することができます。NLI
中心からｘ座標を－４００させた位置に待機させて表示しました。R

@bs_set(rk11_01, -400, -600, 1500, 100)
@wipe(0)

あまり使うことはないと思いますが、ｙ座標、拡縮、回転角度も設定することができます。
さらにｙ座標を－６００、サイズを１．５倍、１０度回転させて立ち絵を表示しました。R

@bs_set(bs1_rk11_01, -700)
@bs_set(bs1_sp11_01, -400)
@bs_set(bs1_fm11_01, -100)
@bs_set(bs1_hr11_01, 100)
@bs_set(bs1_ri11_01, 400)
@bs_set(bs1_ai11_01, 700)
@wipe(0)

"["＠ｂｓ"]"命令では最大５人まででしたが、NLI
"["＠ｂｓ＿ｓｅｔ"]"命令を使用すると、このように５人以上の立ち絵表示ができるようになります。R

立ち絵基本命令サンプルを終了します。R

@サンプルシーン終了

goto #z00_02


//-----------------------------------------------------------------
// 立ち絵：表情指定
//-----------------------------------------------------------------
#z21

@サンプルシーン開始

表情指定サンプル。R

@bs(rk11_02)

２番の表情を表示しました。NLI
表情は末尾２桁の数字で指定できます。R

@bs(rk11_05)

５番の表情に変更しました。R

@bs(rk12_05)

腕差分を変更しました。NLI
腕差分はキャラクター後の２桁目の数字で指定できます。R
@bs(rk21_05)

向き差分を変更しました。NLI
腕差分はキャラクター後の１桁目の数字で指定できます。R

腕差分と向き差分は指定を入れ替えることができます。NLI
"[app_settings.inc] → [" 立ち絵指定名で向き指定と腕指定の入れ替え有効／無効 "]" から設定できます。R

@bs(bs1_rk21_05)

距離を変更しました。R

@bs(rk11_03)

距離の表記を省略した場合は、前回の距離を引き継ぎます。NLI
初めてキャラクターが表示されるときに距離を省略した場合はデフォルトの距離で表示されます。R

距離のデフォルト値は "[app_settings.inc] → [" 立ち絵が初めて表示された際のデフォルト距離 "]" で設定できます。R

@bs(rk, sp11_01)

キャラクターの指定以外はすべて省略しました。NLI
キャラクター指定だけの場合は、前回の表示したものをすべて引き継ぎます。R

@bs(rk11_08)

表情の末尾２桁に口差分の２桁を追加で指定することで、NLI
キャラクターの口のみを変更することができます。R

@bs(rk11_0801)

８番の表情＋口は１番の表情に変更しました。R

@bs(rk11_01)

立ち絵に拡張差分素材が設定されている場合は、指定の末尾に"["ａ"]"などのアルファベットを追加することで頬染めなどの拡張差分を表示することができます。R

@bs(rk11_01a)

"["ａ"]"を追加して頬染めを表示しました。R

@bs(rk11_0802b)

８番の表情＋口は２番の表情、"["ｂ"]"を追加して汗を表示しました。R

表情指定のサンプルを終了します。R

@サンプルシーン終了

goto #z00_02


//-----------------------------------------------------------------
// 立ち絵：表示モードの変更
//-----------------------------------------------------------------
#z22

@サンプルシーン開始

@bs(rk11_01)

表示モードの変更サンプル。NLI
立ち絵表示時にスライド移動を行いながら表示するかどうかを設定できます。R

@bs(rk11_01, sp11_01)

"[app_settings.inc] → [" 立ち絵ワイプ時の位置調整にスライド移動有効／無効 "]" の値が１ならばスライド移動しながら表示します。NLI
０ならスライド移動は行いません。R

@bs(rk11_01)

表示モードは一時的に変更できます。R

@bs_mode_slide
@bs(rk11_01, sp11_01)

"["＠ｂｓ＿ｍｏｄｅ＿ｓｌｉｄｅ"]"でスライド移動を行う表示をしました。R

@bs(rk11_01)
timewait_key(500)

@bs_mode_wipe
@bs(rk11_01, sp11_01)

"["＠ｂｓ＿ｍｏｄｅ＿ｗｉｐｅ"]"でスライド移動を行わない表示をしました。R

@bs(fm11_01, rk11_01, sp11_01)

どちらも一時的に変更するものなので、"["＠ｂｓ"]" のような立ち位置を調整する命令の後はデフォルト設定に戻ります。R

また、あまり使わないと思いますが、スライド移動の場合は移動にかける時間を設定できます。R

@bs_slide_time(2000)
@bs(fm11_01)

スライド移動にかける時間を２秒にしました。R

表示モードの変更サンプルを終了します。R

@サンプルシーン終了

goto #z00_02


//-----------------------------------------------------------------
// 立ち絵：座標移動
//-----------------------------------------------------------------
#z23

@サンプルシーン開始

@bs(rk11_01)

立ち絵座標移動サンプル。NLI
"["＠ｂｓ＿ｍｏｖｅ"]"系の命令を使用すると立ち絵の移動ができます。R

@bs_move_x(rk, 300, 1000)

"["＠ｂｓ＿ｍｏｖｅ＿ｘ"]"命令で立ち絵を移動しました。NLI
ｘ座標を＋３００させた位置に１秒かけて移動をしています。R

@bs_move_x(rk, -300, 1000, 1)

今回は移動の終了待ちを行いました。NLI
１を設定すると終了待ちを行い、０を設定すると終了を待ちません。R

省略できるパラメータですが、省略した場合はNLI
"[app_settings.inc] → [立ち絵の移動命令時に待ちを行うかどうか]"で設定した値が反映されます。R

@bs_move_y(rk, 100, 1500, 0, 2)

"["＠ｂｓ＿ｍｏｖｅ＿ｙ"]"命令で立ち絵を移動しました。NLI
ｙ座標を＋１００させた位置に１．５秒かけて移動をしています。NLI
加速モードは２（減速）です。R

@bs_move_y(rk, -100, 1500, 0, 1)

加速モードは０が等速、１が加速、２が減速になります。R

@bs_move_y(rk, -100, 1500, 0, 0, 2000)

加速モードを０にして、NLI
さらに移動開始までに２秒の待ちを入れています。R

@bs(rk11_01, sp11_01)
@bs_move(rk, 100, 100, 1000, 1)

"["＠ｂｓ＿ｍｏｖｅ"]"命令はｘｙ座標の両方を指定できます。R

@bs_move(rk, -100, -100, 500, 1)
@bs_move_x(sp, -100, 500, 1)

"["＠ｂｓ＿ｍｏｖｅ"]"系の命令を使用して、NLI
鴉羽の立ち絵を移動した後に灰桜の立ち絵を移動しました。R

@bs_move(rk, 100, 100, 500)
@bs_move_x(sp, 100, 500)

立ち絵を同時に移動させました。R

@bs

また、"[app_settings.inc] → [立ち絵表示時に待ちを行うかどうか]"で設定した値によって移動の動作が少し変わるので注意してください。R

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(0)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行わない
// ----- ↑※

@bs(rk11_01)
@bs_move_x(rk, 100, 1000)

"["立ち絵表示時に待ちを行わない"]"設定の場合は表示すると同時に移動が始まります。R

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(1)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行う
// ----- ↑※

@bs(rk11_01)
@bs_move_x(rk, 100, 1000)

"["立ち絵表示時に待ちを行う"]"設定の場合は表示した後に移動が始まります。R

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(1)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行う
// ----- ↑※

@bs_set(rk11_01)
@bs_move_x(rk, 100, 1000)
@wipe(0)

"["立ち絵表示時に待ちを行う"]"設定の場合で、表示と同時に移動させたい場合は、裏画面に立ち絵を待機させてから移動命令を行うと同時に移動できます。R

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(0)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行わない
// ----- ↑※

@set_wipe_wait(1)
@bs(rk11_01)
@bs_move_x(rk, 100, 1000)

"["立ち絵表示時に待ちを行わない"]"設定の場合で、表示後に移動させたい場合は、"["＠ｓｅｔ＿ｗｉｐｅ＿ｗａｉｔ"]"命令で立ち絵の表示を待つことで目的の動作ができます。R

@bs(rk11_01)

使用する頻度は低いかと思いますが、キャラクターの座標からの距離ではなく直接座標を指定することもできます。R

@bs_move_abs_x(rk, 100, 1000)

"["＠ｂｓ＿ｍｏｖｅ＿ａｂｓ＿ｘ"]"命令で立ち絵を移動しました。NLI
キャラクターのｘ座標に＋１００ではなく、ｘ座標が１００の位置に移動します。R

@bs_move_abs(rk, 960, -600, 1000)

"["＠ｂｓ＿ｍｏｖｅ"]"系の命令と同様にｙ座標のみ、ｘｙ座標両方指定する命令があります。R

立ち絵座標移動サンプルを終了します。R

@サンプルシーン終了

goto #z00_02


//-----------------------------------------------------------------
// 立ち絵：重なり順の変更
//-----------------------------------------------------------------
#z24

@サンプルシーン開始

@bs(rk11_01, sp11_01)

重なり順の変更サンプル。NLI
"["＠ｂｓ＿ｌａｙｅｒ"]"系の命令を使用すると立ち絵の重なり順を変更できます。R

現在は、"[app_settings.ss] → [" 立ち絵キャラクターの登録 "]" の設定でNLI
鴉羽の上に灰桜が表示されています。R

@bs_layer_front(rk, sp)

"["＠ｂｓ＿ｌａｙｅｒ＿ｆｒｏｎｔ"]"命令で鴉羽を灰桜の上に設定します。R

@bs_layer_back(rk, sp)

"["＠ｂｓ＿ｌａｙｅｒ＿ｂａｃｋ"]"命令で鴉羽を灰桜の下に設定します。R

"["＠ｂｓ＿ｌａｙｅｒ＿ｆｒｏｎｔ"]" "["＠ｂｓ＿ｌａｙｅｒ＿ｂａｃｋ"]"でそれぞれ、指定したキャラクターを対象キャラクターの上にするか下にするかを設定できます。R

@bs

また、"[app_settings.inc] → [立ち絵表示時に待ちを行うかどうか]"で設定した値によって動作が少し変わるので注意してください。R

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(0)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行わない
// ----- ↑※

@bs(rk11_01, sp11_01)
@bs_layer_front(rk, sp)

"["立ち絵表示時に待ちを行わない"]"設定の場合は表示すると同時に重なり順が変更されます。R

@set_wipe_type(2)
@set_wipe_wait(1)
@bs

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(1)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行わない
// ----- ↑※

@bs(rk11_01, sp11_01)
@bs_layer_front(rk, sp)

"["立ち絵表示時に待ちを行う"]"設定の場合は表示した後に重なり順が変更されてしまいます。R

@set_wipe_type(2)
@set_wipe_wait(1)
@bs

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_type(2)	// [立ち絵のデフォルトワイプ番号]を無視してワイプ番号を設定する
@set_wipe_wait(1)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行わない
// ----- ↑※

@bs_set(rk11_01, -370)
@bs_set(sp11_01, 370)
@bs_layer_front(rk, sp)
@wipe(0)

"["立ち絵表示時に待ちを行う"]"設定の場合で、表示と同時に重なり順を変更したい場合は、裏画面に立ち絵を待機させてから重なり順を変更すると目的の動作ができます。R

@cg(cg_sp01_0101, 2)
@bs(rk11_01)

イベントＣＧは立ち絵より上に重なりますが、レイヤー値を直接指定することでイベントＣＧの上など自由に重なり順を変更できます。R

@set_bs_layer(rk, <LAYER_CG> + 1)

"["＠ｓｅｔ＿ｂｓ＿ｌａｙｅｒ"]"命令でイベントＣＧの上に重なり順を変更しました。R

重なり順の変更サンプルを終了します。R

@サンプルシーン終了

goto #z00_02

//-----------------------------------------------------------------
// 立ち絵：透明度の変更
//-----------------------------------------------------------------
#z25

@サンプルシーン開始

@bs(rk11_01)

透明度の変更サンプル。NLI
"["＠ｂｓ＿ｔｒ"]"命令を使用すると立ち絵の不透明度を変更できます。R

@bs_tr(rk, 255, 128)

不透明度を１００％から５０％にしました。NLI
不透明度は０（０％）～２５５（１００％）の指定になります。R

@bs_tr(rk, 128, 64, 1000)

不透明度を５０％から２５％に１秒の時間をかけました。NLI
また、変化にかける時間の他に加速モード、変化を開始する時間を設定できます。R

@bs_tr(rk, 64, 255, 1000, 2, 1000)

不透明度を２５％から１００％に１秒の時間をかけ、NLI
加速モードを減速、変化を開始する時間を１秒に設定しています。R

@bg(bg_siro, 2)

@bs_w(3, sp11_01)
@bs_tr(sp, 96)

不透明度を一つしか指定しない場合はそのまま指定した不透明度に変更されます。R

@bg(bg_siro, 2)

// ----- ↓※アプリごとのデフォルト設定を一時的にサンプル用に変更する命令です。
@set_wipe_wait(1)	// [立ち絵表示時に待ちを行うかどうか]を無視してワイプ終了待ちを行わない
// ----- ↑※

@bs_set(rk11_01)
@bs_tr(rk, 128)
@wipe(3)

また、立ち絵のワイプ時に終了待ちが設定されている場合は"["＠ｂｓ＿ｓｅｔ"]"命令と合わせて使用することでワイプと同時に不透明度を変更できます。R

透明度の変更サンプルを終了します。R

@サンプルシーン終了

goto #z00_02


//-----------------------------------------------------------------
// 立ち絵：スライドイン／スライドアウト
//-----------------------------------------------------------------
#z26

@サンプルシーン開始

立ち絵スライドイン／アウトサンプル。NLI
立ち絵指定にスライド命令を追加することによって、スライドイン／アウトを行うことができます。R

@bs(rk11_01@l1)

スライド命令"["＠ｌ１"]"を使用して、左から低速でスライドインしました。R

@bs

スライド命令には"["＠ｌ１"]"＝低速、"["＠ｌ２"]"＝中速、"["＠ｌ３"]"＝高速の３種類の速さがあります。R

@bs(rk11_01@l2)

スライド命令"["＠ｌ２"]"を使用して、左から中速でスライドインしました。R

@set_wipe_wait(1)
@bs

@bs(rk11_01@l3)

スライド命令"["＠ｌ３"]"を使用して、左から高速でスライドインしました。R

スライドアウトしながら立ち絵を消去するには"["＠ｂｓ＿ｄｅｌ"]"のような立ち絵消去命令を合わせて使用することで実行できます。R

@bs_del(rk@l2)

スライド命令"["＠ｌ２"]"を使用して、左へ中速でスライドアウトしました。R

@bs

スライド命令には"["＠ｌ"]"＝左、"["＠ｒ"]"＝右、"["＠ｕ"]"＝上、"["＠ｄ"]"＝下の４種類があります。R

@bs(rk11_01@r2)

スライド命令"["＠ｒ２"]"を使用して、右から中速でスライドインしました。R

@bs(rk11_01, sp11_01@d3)

スライド命令"["＠ｄ３"]"を使用して、下から高速でスライドインしました。R

@bs_del(rk@u1)

スライド命令"["＠ｕ１"]"を使用して、上へ低速でスライドアウトしました。R

立ち絵スライドイン／アウトサンプルを終了します。R

@サンプルシーン終了

goto #z00_02


//-----------------------------------------------------------------
// 立ち絵：アクション
//-----------------------------------------------------------------
#z27

@サンプルシーン開始

@bs(rk11_01)

立ち絵アクションサンプル。NLI
立ち絵指定にアクション命令を追加することによって、アクションを行うことができます。R

@bs(rk11_01@0a)

アクション命令"["＠０ａ"]"を使用して、うんと小さく頷くアクションを行いました。R

@bs(rk11_01@pyon2)

アクション命令"["＠ｐｙｏｎ２"]"を使用して、 ぴょんぴょんと飛び跳ねる（ループ）アクションを行いました。R

@bs(rk11_01, sp11_01)

二人以上の指定の場合も各立ち絵指定の後にアクション命令を追加することで同時に動作します。R

@bs(rk11_01@0d, sp11_01@jump)

アクション命令には"["＠０ｄ"]"という数字＋英字タイプと"["＠ｊｕｍｐ"]"と単語タイプの指定がありますが、指定の違いだけで動作自体は同じものになります。R

"["＠０ｄ"]"のような数字＋英字タイプは慣れればスクリプト作業の速度が速くなるかと思います。R
"["＠ｊｕｍｐ"]"のような単語タイプは視認性はよくなりますが、相対的に作業の速度は遅くなるかと思います。NLI
好みに合わせて使い分けてください。R

@bs

アクション命令は同時に複数追加することができます。R

@bs(rk11_01@l2@0a)

アクション命令 "[l2]" と "[0a]" を使用して、左からスライドインしながら、うんと小さく頷くアクションを行いました。R
命令は複数追加できますが、縦軸（ｘ座標）や横軸（ｙ座標）の動作が同時に行われる場合、座標が加算されるわけではないので注意してください。R

@bs(rk11_01@0a@0b)

上記の "[0a]" と "[0b]" の命令は共にｙ座標を変更するアクションですが、"[0a]" の命令は無視され "[0b]" の命令が優先されます。R

@bs(rk11_01)

また、システムプリセットとしてシステム側でいくつかのアクションを用意していますが、アプリごとに個別でアクション命令を追加することもできます。R
アクション命令は "[app_settings.ss] → [" アクションコマンドの登録 "]" で追加できます。R

@bs(rk11_01@1a)

サンプルで追加した"["＠９ａ"]"ぴょんぴょんぴょんと３回飛ぶアクションを行いました。R

@bs(rk11_01, sp11_01)

次にシステム側で用意しているプリセットアクションの一覧を実行します。R

@bs(rk11_01@0a, sp11_01@un)			"["＠０ａ"]""["＠ｕｎ"]"うんと小さく頷くR
@bs(rk11_01@0b, sp11_01@un2)		"["＠０ｂ"]""["＠ｕｎ２"]"うんうんと頷く（２回）R
@bs(rk11_01@0c, sp11_01@ojigi)		"["＠０ｃ"]""["＠ｏｊｉｇｉ"]"お辞儀をするR
@bs(rk11_01@0d, sp11_01@jump)		"["＠０ｄ"]""["＠ｊｕｍｐ"]"えっと短くジャンプR
@bs(rk11_01@0e, sp11_01@jump2)		"["＠０ｅ"]""["＠ｊｕｍｐ２"]"やったーっと短くジャンプ（２回）R
@bs(rk11_01@0f, sp11_01@iya)		"["＠０ｆ"]""["＠ｉｙａ"]"いやと首を振るR
@bs(rk11_01@0g, sp11_01@iya2)		"["＠０ｇ"]""["＠ｉｙａ２"]"いやいやと首を早く振るR
@bs(rk11_01@0h, sp11_01@biku)		"["＠０ｈ"]""["＠ｂｉｋｕ"]"びくっと動揺するR
@bs(rk11_01@0i, sp11_01@bururu)		"["＠０ｉ"]""["＠ｂｕｒｕｒｕ"]"ぶるるっと悪寒がするR
@bs(rk11_01@0j, sp11_01@gkbr)		"["＠０ｊ"]""["＠ｇｋｂｒ"]"がくぶると動揺する（ループ）R
@bs(rk11_01@0k, sp11_01@fura2)		"["＠０ｋ"]""["＠ｆｕｒａ２"]"疲れ果ててふらふらする（ループ）R
@bs(rk11_01@0l, sp11_01@haa2)		"["＠０ｌ"]""["＠ｈａａ２"]"はーはーと息を切らす（ループ）R
