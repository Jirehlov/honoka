#z00

//---------------------------------------------------------------------------
// 確認ダイアログテキストの取得
//
// -  確認ダイアログで表示されるテキストです
// -  画像が設定されている場合はこのテキストは使われません
// 
//---------------------------------------------------------------------------
command $$get_dialog_text(property $dialog_type) : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)
		switch( $dialog_type ) {
		case(@確認ダイアログ_モード_セーブ)					$text = "セーブしますか？"
		case(@確認ダイアログ_モード_クイックセーブ)			$text = "クイックセーブしますか？"
		case(@確認ダイアログ_モード_上書きセーブ)			$text = "上書きセーブしますか？"
		case(@確認ダイアログ_モード_ロード)					$text = "ロードしますか？"
		case(@確認ダイアログ_モード_クイックロード)			$text = "クイックロードしますか？"
		case(@確認ダイアログ_モード_前の選択肢に戻る)		$text = "前の選択肢に戻りますか？"
		case(@確認ダイアログ_モード_バックログジャンプ)		$text = "履歴から再開しますか？"
		case(@確認ダイアログ_モード_セーブデータ削除)		$text = "データを削除しますか？"
		case(@確認ダイアログ_モード_セーブデータ入れ替え)	$text = "データを入れ替えますか？"
		case(@確認ダイアログ_モード_タイトルに戻る)			$text = "タイトルメニューに戻りますか？"
		case(@確認ダイアログ_モード_エクストラに戻る)		$text = "チャプター選択メニューに戻りますか？"
		case(@確認ダイアログ_モード_ゲームを終了する)		$text = "ゲームを終了しますか？"
		case(@確認ダイアログ_モード_初期設定に戻す)			$text = "初期設定に戻しますか？"
		case(@確認ダイアログ_モード_オートセーブ上書き)		$text = "オートセーブ用データです。"
		default												@dm("99_システム文字.ss → $$get_dialog_text\n定義されていないダイアログタイプが選択されました。\nタイプ番号 : " + math.tostr($dialog_type) + "\n空文字を設定します。")
															$text = ""
		}
	
	case($lang_en)
		switch( $dialog_type ) {
		case(@確認ダイアログ_モード_セーブ)					$text = "Do you want to save?"
		case(@確認ダイアログ_モード_クイックセーブ)			$text = "Do you want to quick save?"
		case(@確認ダイアログ_モード_上書きセーブ)			$text = "Are you sure you want to overwrite this save?"
		case(@確認ダイアログ_モード_ロード)					$text = "Do you want to load?"
		case(@確認ダイアログ_モード_クイックロード)			$text = "Do you want to quick load?"
		case(@確認ダイアログ_モード_前の選択肢に戻る)		$text = "Are you sure you want to jump to the previous choice?"
		case(@確認ダイアログ_モード_バックログジャンプ)		$text = "Do you want to return to this point?"
		case(@確認ダイアログ_モード_セーブデータ削除)		$text = "Are you sure you want to delete this save data?"
		case(@確認ダイアログ_モード_セーブデータ入れ替え)	$text = "Do you want to swap save slots?"
		case(@確認ダイアログ_モード_タイトルに戻る)			$text = "Are you sure you want to return to the title screen?"
		case(@確認ダイアログ_モード_エクストラに戻る)		$text = "Are you sure you want to return to the chapter screen?"
		case(@確認ダイアログ_モード_ゲームを終了する)		$text = "Are you sure you want to exit the game?"
		case(@確認ダイアログ_モード_初期設定に戻す)			$text = "Do you want to restore the default settings?"
		case(@確認ダイアログ_モード_オートセーブ上書き)		$text = "※未翻訳"
		default												@dm("99_システム文字.ss → $$get_dialog_text\n定義されていないダイアログタイプが選択されました。\nタイプ番号 : " + math.tostr($dialog_type) + "\n空文字を設定します。")
															$text = ""
		}
		
	default
		@dm("99_システム文字.ss → $$get_dialog_text\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// セーブコメントのデフォルト文字列を取得する
//---------------------------------------------------------------------------
command $$get_default_save_comment_text(property $comment_type) : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)
		switch( $comment_type ) {
		case(@セーブロード_コメントタイプ_通常)			$text = "ここにコメントを入力できます"
		case(@セーブロード_コメントタイプ_ロック)		$text = "ロック中は入力できません"
		}
		
	case($lang_en)
		switch( $comment_type ) {
		case(@セーブロード_コメントタイプ_通常)			$text = "※未翻訳"
		case(@セーブロード_コメントタイプ_ロック)		$text = "※未翻訳"
		}
	default
		@dm("99_システム文字.ss → $$get_default_save_comment_text\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// コンフィグ／テキストで表示するサンプルテキストを取得する
//---------------------------------------------------------------------------
command $$get_config_sample_text : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)
		
		$text = "これはテキストの速度表示サンプルです。"
		
	case($lang_en)
		
		$text = "※未翻訳"
		
	default
		@dm("99_システム文字.ss → $$get_config_sample_text\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// 文字数がテキスト描画範囲をオーバーした際に表示する文字列を取得する
//---------------------------------------------------------------------------
command $$get_message_over_text : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)		$text = "…"
	case($lang_en)		$text = "…"
	default
		@dm("99_システム文字.ss → $$get_dialog_text\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// 立ち絵鑑賞保存時に使用するファイル名を取得する
//---------------------------------------------------------------------------
command $$get_extra_character_save_filename : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)		$text = "anemoiキャラクター鑑賞"
	case($lang_en)		$text = "※未翻訳"
	default
		@dm("99_システム文字.ss → $$get_extra_character_save_filename\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// レコードを獲得したときのテキストを取得する
//---------------------------------------------------------------------------
command $$get_record_title : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)		$text = "レコードを獲得しました！"
	case($lang_en)		$text = "※未翻訳"
	default
		@dm("99_システム文字.ss → $$get_record_get_text\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// レコード名を取得する
//---------------------------------------------------------------------------
command $$get_record_name(property $record_no) : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)
		
		switch( $record_no ) {
		case(@レコード_辻倉朱比華ルートをクリアした)								$text = "辻倉朱比華ルートをクリアした"
		case(@レコード_総羽愛乃ルートをクリアした)									$text = "総羽愛乃ルートをクリアした"
		case(@レコード_淡雪陽彩ルートをクリアした)									$text = "淡雪陽彩ルートをクリアした"
		case(@レコード_白渡小詠ルートをクリアした)									$text = "白渡小詠ルートをクリアした"
		case(@レコード_速川六花ルートをクリアした)									$text = "速川六花ルートをクリアした"
		case(@レコード_尾道文弥ルートをクリアした)									$text = "尾道文弥ルートをクリアした"
		case(@レコード_敦澤塁ルートをクリアした)									$text = "敦澤塁ルートをクリアした"
		case(@レコード_華押つづらルートをクリアした)								$text = "華押つづらルートをクリアした"
		case(@レコード_河瀬千春ルートをクリアした)									$text = "河瀬千春ルートをクリアした"
		case(@レコード_小森健ルートをクリアした)									$text = "小森健ルートをクリアした"
		case(@レコード_eternicleをクリアした)										$text = "ｅｔｅｒｎｉｃｌｅをクリアした"
		case(@レコード_anemoiをクリアした)											$text = "ａｎｅｍｏｉをクリアした"
		case(@レコード_全ルートをクリアした)										$text = "全ルートをクリアした"
			
		case(@レコード_スピカに「生意気盛りの１０歳」と言った)						$text = "スピカに「生意気盛りの１０歳」と言った"
		case(@レコード_スピカに「夢見る年頃の１５歳」と言った)						$text = "スピカに「夢見る年頃の１５歳」と言った"
		case(@レコード_スピカに「少し疲れた２１歳」と言った)						$text = "スピカに「少し疲れた２１歳」と言った"
		case(@レコード_スピカに「なんとびっくり３５歳」と言った)					$text = "スピカに「なんとびっくり３５歳」と言った"
		case(@レコード_朝食は味噌汁派)												$text = "朝食は味噌汁派"
		case(@レコード_出会ってすぐの河瀬と勝負した)								$text = "出会ってすぐの河瀬と勝負した"
		case(@レコード_出会ってすぐの河瀬と勝負しないでほっといた)					$text = "出会ってすぐの河瀬と勝負しないでほっといた"
		case(@レコード_マスミンズアダルトタイムに参加した)							$text = "マスミンズアダルトタイムに参加した"
		case(@レコード_二つ名『ゴーストバスター』を手に入れた)						$text = "二つ名『ゴーストバスター』を手に入れた"
		case(@レコード_二つ名『幼女ハンター』を手に入れた)							$text = "二つ名『幼女ハンター』を手に入れた"
		
		case(@レコード_二つ名『制服ハンター』を手に入れた)							$text = "二つ名『制服ハンター』を手に入れた"
		case(@レコード_二つ名『ドＭ』を手に入れた)									$text = "二つ名『ドＭ』を手に入れた"
		case(@レコード_二つ名『人妻ハンター』を手に入れた)							$text = "二つ名『人妻ハンター』を手に入れた"
		case(@レコード_二つ名『人妻キラー』を手に入れた)							$text = "二つ名『人妻キラー』を手に入れた"
		case(@レコード_淡雪と出会ってすぐにキスをした)								$text = "淡雪と出会ってすぐにキスをした"
		case(@レコード_妄想で六花とベロちゅーさせられた)							$text = "妄想で六花とベロちゅーさせられた"
		case(@レコード_地球とキスをした)											$text = "地球とキスをした"
		case(@レコード_スピカとフィーリングクイズをした)							$text = "スピカとフィーリングクイズをした"
		case(@レコード_男３人でフィーリングクイズをした)							$text = "男３人でフィーリングクイズをした"
		case(@レコード_意図せず可愛くなった依頼書を引き受けた)						$text = "意図せず可愛くなった依頼書を引き受けた"
		
		case(@レコード_すごく葛藤を感じる依頼書を引き受けた)						$text = "すごく葛藤を感じる依頼書を引き受けた"
		case(@レコード_ピザ大会で『トマト畑でつかまえて』を作った)					$text = "ピザ大会で『トマト畑でつかまえて』を作った"
		case(@レコード_ピザ大会で『マシュマロぴっざ』を作った)						$text = "ピザ大会で『マシュマロぴっざ』を作った"
		case(@レコード_ピザ大会で『シーフードピザ』を作った)						$text = "ピザ大会で『シーフードピザ』を作った"
		case(@レコード_ピザ大会で『ハワイアンピザ』を作った)						$text = "ピザ大会で『ハワイアンピザ』を作った"
		case(@レコード_スピカが『風の一族』だと打ち明けてしまった)					$text = "スピカが『風の一族』だと打ち明けてしまった"
		case(@レコード_スピカに『風のスピカ』という二つ名を授けた)					$text = "スピカに『風のスピカ』という二つ名を授けた"
		case(@レコード_スピカが『風の王』の風格を手にした)							$text = "スピカが『風の王』の風格を手にした"
		case(@レコード_スピカが『風大好き一族』だということにした)					$text = "スピカが『風大好き一族』だということにした"
		case(@レコード_スピカは『風大好きスピカ』として風を嬉しんだ)				$text = "スピカは『風大好きスピカ』として風を嬉しんだ"
		
		case(@レコード_スピカは『風大好キング』としてのろけた)						$text = "スピカは『風大好キング』としてのろけた"
		case(@レコード_スピカは『風車の一族』の来歴を語った)						$text = "スピカは『風車の一族』の来歴を語った"
		case(@レコード_スピカは『風車のスピカ』と呼ばれるくノ一だった)				$text = "スピカは『風車のスピカ』と呼ばれるくノ一だった"
		case(@レコード_スピカが『風車王スピカイザー』の名を叫んだ)					$text = "スピカが『風車王スピカイザー』の名を叫んだ"
		case(@レコード_愛乃と鳥野郎コンテストに出ることに決めた)					$text = "愛乃と鳥野郎コンテストに出ることに決めた"
		case(@レコード_愛乃の鳥野郎コンテストへの誘いを断った)						$text = "愛乃の鳥野郎コンテストへの誘いを断った"
		case(@レコード_ゾンビに間違われた)											$text = "ゾンビに間違われた"
		case(@レコード_町長がギンギンにみなぎった)									$text = "町長がギンギンにみなぎった"
		case(@レコード_鳥野郎コンテストの助っ人にスピカを誘った)					$text = "鳥野郎コンテストの助っ人にスピカを誘った"
		case(@レコード_鳥野郎コンテストの助っ人に六花を誘った)						$text = "鳥野郎コンテストの助っ人に六花を誘った"
		
		case(@レコード_鳥野郎コンテストの助っ人に淡雪を誘った)						$text = "鳥野郎コンテストの助っ人に淡雪を誘った"
		case(@レコード_鳥野郎コンテストの助っ人に健さんを誘った)					$text = "鳥野郎コンテストの助っ人に健さんを誘った"
		case(@レコード_鳥野郎コンテストの助っ人に塁を誘った)						$text = "鳥野郎コンテストの助っ人に塁を誘った"
		case(@レコード_チーム名は…空中プロジェクトだ)								$text = "チーム名は…空中プロジェクトだ"
		case(@レコード_チーム名は…大麦１００％だ)									$text = "チーム名は…大麦１００％だ"
		case(@レコード_チーム名は…素粒子だ)										$text = "チーム名は…素粒子だ"
		case(@レコード_淡雪がすじこコロネを食べた)									$text = "淡雪がすじこコロネを食べた"
		case(@レコード_淡雪がチョコおにぎりを食べた)								$text = "淡雪がチョコおにぎりを食べた"
		case(@レコード_淡雪がやるべきことは深海魚ハンターだ)						$text = "淡雪がやるべきことは深海魚ハンターだ"
		case(@レコード_淡雪がやるべきことは山のハンターだ)							$text = "淡雪がやるべきことは山のハンターだ"
		
		case(@レコード_淡雪がやるべきことは愛のハンターだ)							$text = "淡雪がやるべきことは愛のハンターだ"
		case(@レコード_淡雪の依頼を見て仕事にやってきた)							$text = "淡雪の依頼を見て仕事にやってきた"
		case(@レコード_つづらの依頼を見て仕事にやってきた)							$text = "つづらの依頼を見て仕事にやってきた"
		case(@レコード_淡雪の美しさに気づいた)										$text = "淡雪の美しさに気づいた"
		case(@レコード_つづらの綺麗さに気づいた)									$text = "つづらの綺麗さに気づいた"
		case(@レコード_三人集まってもバカ)											$text = "三人集まってもバカ"
		case(@レコード_淡雪とつづらのキスを見た)									$text = "淡雪とつづらのキスを見た"
		case(@レコード_とても怖い夢を見た気がする)									$text = "とても怖い夢を見た気がする"
		case(@レコード_美しい話を見たい)											$text = "美しい話を見たい"
		case(@レコード_美しくない話を見たい)										$text = "美しくない話を見たい"
		
		case(@レコード_自分の気持ちを抑えた)										$text = "自分の気持ちを抑えた"
		case(@レコード_もう綺麗なものはない泡宇宙を選んだ)							$text = "もう綺麗なものはない泡宇宙を選んだ"
		case(@レコード_もう綺麗なものがない泡宇宙を否定した)						$text = "もう綺麗なものがない泡宇宙を否定した"
		case(@レコード_小詠は遊び（ピザ作り）で好きな食べものを見つけた)			$text = "小詠は遊び（ピザ作り）で好きな食べものを見つけた"
		case(@レコード_小詠は遊び（傘旅）を楽しんだ)								$text = "小詠は遊び（傘旅）を楽しんだ"
		case(@レコード_小詠は遊び（なんか長い名前のやつ）で脚を鍛えられた)			$text = "小詠は遊び（なんか長い名前のやつ）で脚を鍛えられた"
		case(@レコード_小詠は遊び（麻袋リレー）で『あさキング』の称号を得た)		$text = "小詠は遊び（麻袋リレー）で『あさキング』の称号を得た"
		case(@レコード_小詠は遊び（高速ジャンケン）で河瀬の誤解を解いた)			$text = "小詠は遊び（高速ジャンケン）で河瀬の誤解を解いた"
		case(@レコード_小詠は遊び（化石発掘）で能力に目覚めた)						$text = "小詠は遊び（化石発掘）で能力に目覚めた"
		case(@レコード_小詠は遊び（マシンガン早口言葉）で滑舌が改善した)			$text = "小詠は遊び（マシンガン早口言葉）で滑舌が改善した"
		
		case(@レコード_小詠は遊び（辞書単語バトル）を経てコーヒーにハマった)		$text = "小詠は遊び（辞書単語バトル）を経てコーヒーにハマった"
		case(@レコード_高速ジャンケンで完全勝利した)								$text = "高速ジャンケンで完全勝利した"
