		case(@レコード_ヘビパで最大コンボ３０を達成した)					$text = "ヘビヘビパニックで最大コンボ３０を達成した"
		case(@レコード_ヘビパで最大コンボ６０を達成した)					$text = "ヘビヘビパニックで最大コンボ６０を達成した"
		case(@レコード_ヘビパで最大コンボ１００を達成した)					$text = "ヘビヘビパニックで最大コンボ１００を達成した"
		case(@レコード_ヘビパでスコア１００００を獲得した)					$text = "ヘビヘビパニックでスコア１００００を獲得した"
		case(@レコード_ヘビパでスコア５００００を獲得した)					$text = "ヘビヘビパニックでスコア５００００を獲得した"
		case(@レコード_ヘビパでスコア１０００００を獲得した)				$text = "ヘビヘビパニックでスコア１０００００を獲得した"
		case(@レコード_ヘビパでボスを１ターン以内に倒した)					$text = "ヘビヘビパニックでボスを１ターン以内に倒した"
		case(@レコード_ヘビパで河瀬を倒した)								$text = "ヘビヘビパニックで通りすがりの河瀬を倒した"
		case(@レコード_ヘビパで小森を倒した)								$text = "ヘビヘビパニックで通りすがりの小森を倒した"
		case(@レコード_ヘビパでヤマタノオロチを倒した)						$text = "ヘビヘビパニックでヤマタノオロチを倒した"
		case(@レコード_ヘビパでヒュドラを倒した)							$text = "ヘビヘビパニックでヒュドラを倒した"
		case(@レコード_ヘビパでメデューサを倒した)							$text = "ヘビヘビパニックでメデューサを倒した"
		*/
		
		// レコード未獲得時のテキスト
		default								$text = "？？？？？？？"
		}
		
	case($lang_en)		$text = "※未翻訳"
	default
		@dm("99_システム文字.ss → $$get_extra_character_save_filename\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text = ""
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// 称号獲得時のテキストを取得する
//---------------------------------------------------------------------------
command $$get_title_get_text(property $title_name : str) : str
{
	property $text : str
	
	switch( @check_lang ) {
	
	case($lang_jp)		$text = "『" + $title_name + "』を手に入れた！"
	case($lang_en)		$text = $title_name /* ※未翻訳 */
	default
		@dm("99_システム文字.ss → $$get_dialog_text\n定義されていない言語が選択されました。\n言語番号 : " + math.tostr(@check_lang) + "\n空文字を設定します。")
		$text =""
	}
	
	return ($text)
}


//---------------------------------------------------------------------------
// 小詠Play07質問
//---------------------------------------------------------------------------
command $$get_kyplay07_question_text(property $id) : str
{
	property $text: str
	
	switch( $id ) {
	case(0)		$text = "庭には２羽鶏がいる"
	case(1)		$text = "買った肩たたき機高かった"
	case(2)		$text = "この釘は引き抜きにくい釘だ"
	case(3)		$text = "最優秀伴奏者賞"
	case(4)		$text = "竹垣に竹立てかけた"
	case(5)		$text = "東京特許許可局"
	case(6)		$text = "なかなかカタカナ書けなかったな"
	case(7)		$text = "坊主が屏風に上手に坊主の絵を描いた"
	case(8)		$text = "私はあなたに哀れまれたくないのだ"
	case(9)		$text = "隣の客はよく柿食う客だ"
	}
	
	return ($text)
}

//---------------------------------------------------------------------------
// 小詠Play07回答
//---------------------------------------------------------------------------
command $$get_kyplay07_anser_text(property $id, property $index) : str
{
	property $text: str
	
	// 正解はindex = 0
	switch( $id ) {
	case(0)		
		switch( $index ) {
		case(0)		$text = "にわにはにわにわとりがいる"
		case(1)		$text = "にわにはにわにわにわとりがいる"
		case(2)		$text = "にわにははにわととりがいる"
		case(3)		$text = "にわはにわとりとにとりがいる"
		}
	case(1)
		switch( $index ) {
		case(0)		$text = "かったかたたたききたかかった"
		case(1)		$text = "かったたかかたきたきたかった"
		case(2)		$text = "かっかたたかきかたかかたった"
		case(3)		$text = "かっきたかたたきたかたたった"
		}
	case(2)
		switch( $index ) {
		case(0)		$text = "このくぎはひきぬきにくいくぎだ"
		case(1)		$text = "このぐきはぬきひきにくいぐきだ"
		case(2)		$text = "このくぎはひきぬきぬくいぬぎだ"
		case(3)		$text = "このくぎはぬきひきぬくいくぎだ"
		}
	case(3)
		switch( $index ) {
		case(0)		$text = "さいゆうしゅうばんそうしゃしょう"
		case(1)		$text = "さいゆうすうばんそうしゃそう"
		case(2)		$text = "さいしゅうしゅうばんしょうしゃそう"
		case(3)		$text = "さいしゅうすうばんそうさしょう"
		}
	case(4)
		switch( $index ) {
		case(0)		$text = "たけがきにたけたてかけた"
		case(1)		$text = "たけがきにたけたけたてた"
		case(2)		$text = "たけがきにたてたてかけた"
		case(3)		$text = "たけがきにたけたかけてた"
		}
	case(5)
		switch( $index ) {
		case(0)		$text = "とうきょうとっきょきょかきょく"
		case(1)		$text = "とうきょうとっきょきょきゃきょく"
		case(2)		$text = "とうきょうとっきょこかきょきゅ"
		case(3)		$text = "とうきょうとっきょかきょきょく"
		}
	case(6)
		switch( $index ) {
		case(0)		$text = "なかなかかたかなかけなかったな"
		case(1)		$text = "なかなかかたかたかけたかったな"
		case(2)		$text = "なかなかかなかなかけなかったな"
		case(3)		$text = "なかなかなかなかかけなかったな"
		}
	case(7)
		switch( $index ) {
		case(0)		$text = "ぼうずがびょうぶにじょうずにぼうずのえをかいた"
		case(1)		$text = "ぼうずがぼうぶにじょうずにびょうずのえをかいた"
		case(2)		$text = "びょうずがびょうぶにぞうずにぼうずのえをかいた"
		case(3)		$text = "じょうずがぼうずにぼうぶにびょうずのえをかいた"
		}
	case(8)
		switch( $index ) {
		case(0)		$text = "わたしはあなたにあわれまれたくないのだ"
		case(1)		$text = "わたしはあなたにあわれたれたくないのだ"
		case(2)		$text = "わたしはあわたにあなれまれなくないのだ"
		case(3)		$text = "たわしはあたなにあわれまれなくたいのだ"
		}
	case(9)
		switch( $index ) {
		case(0)		$text = "となりのきゃくはよくかきくうきゃくだ"
		case(1)		$text = "となりのきゃきゅはよきゅかきくうきゃくだ"
		case(2)		$text = "となりのかくはよくきゃきくうきゃくだ"
		case(3)		$text = "となりのきゃくはよきゅかききゅうきゃくだ"
		}
	}
	
	return ($text)
}
